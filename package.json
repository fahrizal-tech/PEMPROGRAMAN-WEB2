{
  "name": "nexus-lms-admin-panel",
  "version": "1.1.0",
  "private": true,
  "description": "Admin Panel LMS — Tugas Pemrograman Web 2 (Client-Side Programming)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i assets/css/src/app.css -o assets/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i assets/css/src/app.css -o assets/css/app.css --watch",
    "serve": "npx --yes serve . -l 3000",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "node tests/e2e/run.js",
    "test:all": "npm test && npm run test:e2e",
    "test:html": "node tests/quality/html.js",
    "test:lighthouse": "node tests/quality/lighthouse.js"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "html-validate": "^9.7.1",
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^3.4.19"
  }
}
